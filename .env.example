# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=flashhub
DB_PASSWORD=flashhub_secret
DB_DATABASE=flashhub_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=flashhub-engine
KAFKA_GROUP_ID=flashhub-order-group

